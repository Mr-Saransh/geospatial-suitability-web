# Environment mode
ENVIRONMENT=development

# Primary Spatial Knowledge Package root (.gdb directory)
# For local development: configure path to the canonical package (e.g. run_63)
# For cloud deployment: configure to mounted container/volume path (e.g. /app/data/Himachal_Pradesh_Spatial_Knowledge.gdb)
SPATIAL_KNOWLEDGE_ROOT=C:\path\to\Himachal_Pradesh_Spatial_Knowledge.gdb

# Optional model-specific package roots (override primary root if models are in separate packages)
FLOOD_SPATIAL_KNOWLEDGE_ROOT=
LANDSLIDE_SPATIAL_KNOWLEDGE_ROOT=

# Allowed CORS origins (comma-separated, e.g. production frontend worker and local development)
CORS_ORIGINS=https://geospatial-suitability-web.dssintern1.workers.dev,http://localhost:5173

# Local Ollama AI Assistant (Host machine only, never exposed to public internet)
# Start Ollama locally: http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Run `ollama run llama3.2:1b` or `ollama pull qwen2.5:1.5b`
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=45.0
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_CONCURRENT_GENERATIONS=2
